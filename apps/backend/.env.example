# Application
NODE_ENV=development
PORT=3000
API_PREFIX=v1

# Database (Supabase PostgreSQL)
DATABASE_URL=postgresql://postgres:password@localhost:5432/camp_bjj?schema=public
DIRECT_URL=postgresql://postgres:password@localhost:5432/camp_bjj?schema=public

# Supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_JWT_SECRET=your-jwt-secret

# Supabase Storage
SUPABASE_STORAGE_BUCKET=camp-bjj-private

# CORS
CORS_ORIGIN=http://localhost:3001

# JWT (for NestJS passport-jwt strategy)
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRES_IN=1d

# Rate limiting
THROTTLE_TTL=60
THROTTLE_LIMIT=100